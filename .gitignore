# Agrovia Monorepo Root .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/ios/Flutter/.last_build_id
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/app/src/main/res/raw/
app/*.lock

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Build & Dist Outputs
backend/dist/
backend/coverage/
build/
dist/

# Large ML Models & Raw Datasets (Local storage only)
datasets/
"AI models/"
*.tflite.large
*.gguf
*.onnx.large
*.bin
*.tar.gz
*.zip

# OS & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.claude/
